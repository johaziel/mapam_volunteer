/**
 * Implements hook_preprocess_entity_print().
 */
function mapam_volunteer_preprocess_entity_print__view__flagging_index(array &$variables) {
  $view = $variables['content'][0]['#view'];
  $event_id = reset($view->args);
  $event = \Drupal::entityTypeManager()->getStorage('node')->load($event_id);
  $variables['view_title'] = t('Planning for @label', ['@label' => $event->label()]);
}

/**
 * Implements hook_preprocess_entity_print().
 */
function mapam_volunteer_preprocess_entity_print__view__pole_planning(array &$variables) {
  $view = $variables['content'][0]['#view'];
  $pole_id = reset($view->args);
  $pole = \Drupal::entityTypeManager()->getStorage('node')->load($pole_id);
  $variables['view_title'] = t('Planning for @label', ['@label' => $pole->label()]);
}

/**
 * Implements hook_preprocess_entity_print().
 */
function mapam_volunteer_preprocess_entity_print__view__flagging_index_per_pole(array &$variables) {
  $view = $variables['content'][0]['#view'];
  $pole_id = reset($view->args);
  $pole = \Drupal::entityTypeManager()->getStorage('node')->load($pole_id);
  $variables['view_title'] = t('Planning for @label', ['@label' => $pole->label()]);
}

/**
 * Implements hook_theme_suggestions_HOOK().
 */
function mapam_volunteer_theme_suggestions_entity_print(array $variables) {
  $suggestions = [];
  // Get the render array being printed.
  if (!empty($variables['content'][0]['#view'])) {
    /** @var \Drupal\views\ViewExecutable $view */
    $view = $variables['content'][0]['#view'];
    if ($view && $view->id()) {
      // Add a suggestion based on the view machine name.
      $suggestions[] = 'entity_print__view__' . $view->id();

      // Also allow display-based suggestion (e.g. page, block).
      if ($view->current_display) {
        $suggestions[] = 'entity_print__view__' . $view->id() . '__' . $view->current_display;
      }
    }
  }
  return $suggestions;
}

/**
 * Implements hook_preprocess_entity_print() for entity-print templates.
 *
 * See https://www.drupal.org/project/commerce/issues/2831952#comment-13993663.
 */
function mapam_volunteer_preprocess_entity_print(&$vars) {
  if ($vars['theme_hook_original'] == 'entity_print__view__planning_table') {
    if (isset($vars['content'][0][0]['#theme'])) {
      $vars['content'][0][0]['#theme'] = 'planning_table__entity_print__view';
    }
    if (isset($vars['content'][0]['#theme'])) {
      $vars['content'][0]['#theme'] = 'planning_table__entity_print__view';
    }
  }
}

/**
 * Implements hook_theme_suggestions_item_list_alter() for form templates.
 */
function mapam_volunteer_theme_suggestions_item_list_alter(array &$suggestions, array $variables, $hook) {

  if (isset($variables['element']['#id'])) {
    $id = str_replace("-", "_", $variables['element']['#id']);
    $suggestions[] = $hook . '__' . $id;
  }
}

/**
 * Get the count of flag for an entity.
 */
function mapam_volunteer_get_current_flag_count($entity) {
  $connection = Database::getConnection();

  return (int) $connection->select('flag_counts', 'fc')
    ->condition('fc.flag_id', 'volunteer')
    ->condition('fc.entity_type', $entity->getEntityTypeId())
    ->condition('fc.entity_id', $entity->id())
    ->fields('fc', ['count'])
    ->execute()
    ->fetchField();
}

/**
 * Implements template_preprocess_THEME().
 */
function template_preprocess_flag_fse_link(&$variables) {

  // Skip modifications for admin_theme (Gin).
  if ($variables['is_admin']) {
    $variables['attributes']['class'] = array_merge(
      $variables['attributes']['class'] ?? [], ['button--primary', 'button']);
    return;
  }

  // Change modal dialog type.
  $variables['attributes']['data-dialog-type'] = 'bootstrap4_modal';
  $variables['attributes']['class'] = array_merge($variables['attributes']['class'] ?? [], ['text-secondary']);

  // Decode dialog options to inspect them.
  $dialog_options = Json::decode($variables['attributes']['data-dialog-options']);

  // Add custom classes to the dialog.
  $modal_classes = ['modal-dialog-centered', 'modal-xl'];

  // Add 'modal-dialog-centered' class to center the dialog vertically.
  if (isset($dialog_options['dialogClass'])) {
    // Add the class to existing ones.
    $dialog_options['dialogClass'] = array_merge($dialog_options['dialogClass'], $modal_classes);
  }
  else {
    $dialog_options['dialogClass'] = $modal_classes;
  }

  // Re-encode and set the modified dialog options.
  $variables['attributes']['data-dialog-options'] = Json::encode($dialog_options);
}

/**
 * Implements template_preprocess_THEME().
 */
function template_preprocess_flag_fse_fallback_link(&$variables) {
  $flag = $variables['flag'];
  $entity = $variables['flaggable'];
  $action = $variables['action'];
  $account = \Drupal::currentUser();
  if (!$entity || !$entity->hasField('field_flag_limit')) {
    return;
  }

  // Skip modifications for admin_theme (Gin).
  if ($variables['is_admin']) {
    $variables['attributes']['class'] = array_merge(
      $variables['attributes']['class'] ?? [],
      ['button--small', 'button']
    );
    $variables['display_flag_link'] = FALSE;
  }
  else {
    // Add Bootstrap button classes for the default theme.
    $variables['attributes']['class'] = array_merge(
      $variables['attributes']['class'] ?? [],
      ['btn', 'btn-outline-secondary']
    );
  }

  /** @var \Drupal\mapam_volunteer\RegistrationValidator $validator */
  $validator = \Drupal::service('mapam_volunteer.registration_validator');
  $limit = $validator->getLimit($entity);
  $current = $validator->getRegistrationCount($entity);

  $variables['flag_limit'] = $limit ?? 'unlimited';
  $variables['flag_current'] = $current;
  $variables['flag_remaining'] = $limit === NULL ? NULL : max(0, $limit - $current);

  // Passer aussi une info pour masquer le bouton si complet.
  $variables['flag_full'] = ($limit !== NULL && $current >= $limit);

  // The deadlines do not apply to users who may bypass them.
  if ($flag->id() !== RegistrationValidator::FLAG_ID || $account->hasPermission(RegistrationValidator::BYPASS_PERMISSION)) {
    return;
  }
  if ($action == 'flag' && $validator->isDeadlinePassed($entity, 'flag')) {
    $variables['flag_deadline_passed'] = TRUE;
    $variables['attributes']['class'][] = 'flag-deadline-passed';
    $variables['#attached']['library'][] = 'gin/gin_description_toggle';
  }
  if ($action == 'unflag' && $validator->isDeadlinePassed($entity, 'unflag')) {
    $variables['unflag_deadline_passed'] = TRUE;
    $variables['attributes']['class'][] = 'unflag-deadline-passed';
    $variables['#attached']['library'][] = 'gin/gin_description_toggle';
  }
  // The link changes when the deadlines pass.
  foreach (['flag', 'unflag'] as $deadline_action) {
    $deadline = $validator->getDeadline($entity, $deadline_action);
    if ($deadline !== NULL && $deadline > \Drupal::time()->getRequestTime()) {
      $variables['#cache']['max-age'] = min($variables['#cache']['max-age'] ?? PHP_INT_MAX, $deadline - \Drupal::time()->getRequestTime());
    }
  }
}

/**
 * Implements hook_views_data_alter().
 */
function mapam_volunteer_views_data_alter(array &$data) {

  $flags = \Drupal::service('flag')->getAllFlags();
  $entity_type_manager = \Drupal::entityTypeManager();

  foreach ($flags as $flag) {
    $entity_type_id = $flag->getFlaggableEntityTypeId();

    $entity_type = $entity_type_manager->getDefinition($entity_type_id);
    if ($entity_type->hasHandlerClass('views_data')) {
      $base_table = $entity_type_manager->getHandler($entity_type_id, 'views_data')->getViewsTableForEntityType($entity_type);
      $data[$base_table]['entity_flag_count'] = [
        'field' => [
          'title' => t('Entity Flag Count'),
          'help' => t('Display flagged count for an entity (return 0 for unflaged entity)'),
          'id' => 'entity_flag_count',
        ],
      ];
    }
  }

  // Until this issue is fixed.
  // see : https://www.drupal.org/project/flag/issues/2723703
  /** @var \Drupal\Core\Entity\EntityFieldManagerInterface $entity_field_manager */
  $entity_type_manager = \Drupal::entityTypeManager();
  foreach (Flag::loadMultiple() as $flag_id => $flag) {
    /** @var \Drupal\flag\Entity\Flag $flag */
    $entity_type = $entity_type_manager->getDefinition($flag->getFlaggableEntityTypeId());
    if ($base = $entity_type->getDataTable() ?: $entity_type->getBaseTable()) {
      // Add a relationship for non-bundable entities, and for bundable
      // entities of all bundle types.
      $data['flagging']['flag_' . $flag_id]['relationship'] = [
        'title' => $entity_type->getLabel() . ': ' . $flag->label,
        'help' => t('The %entity_type this %flag_label flagging belongs to.', [
          '%entity_type' => $entity_type->getLabel(),
          '%flag_label' => $flag->label,
        ]),
        'base' => $base,
        'base field' => $entity_type->getKey('id'),
        'relationship field' => 'entity_id',
        'id' => 'standard',
        'label' => $entity_type->getLabel(),
        'extra' => [
          [
            'field' => 'flag_id',
            'value' => $flag_id,
            'table' => 'flagging',
          ],
        ],
      ];

      // Add a relationship for bundable entities for each bundle type.
      $bundles = $flag->getBundles();
      foreach ($bundles as $bundle_id) {
        $data['flagging']['flag_' . $flag_id . '_' . $bundle_id]['relationship'] = [
          'title' => $entity_type->getLabel() . ': ' . $flag->label . ': ' . $bundle_id,
          'help' => t('The %entity_type of type %bundle_id this %flag_label flagging belongs to.', [
            '%entity_type' => $entity_type->getLabel(),
            '%bundle_id' => $bundle_id,
            '%flag_label' => $flag->label,
          ]),
          'base' => $base,
          'base field' => $entity_type->getKey('id'),
          'relationship field' => 'entity_id',
          'id' => 'standard',
          'label' => $entity_type->getLabel(),
          'extra' => [
            [
              'field' => 'flag_id',
              'value' => $flag_id,
              'table' => 'flagging',
            ],
            [
              'field' => 'type',
              'value' => $bundle_id,
              'table' => 'node_field_data',
            ],
          ],
        ];
      }
    }
  }

  // Add Count Flags by Pole field.
  $data['node_field_data']['count_flags_by_pole'] = [
    'field' => [
      'title' => t('Count of flags by pole'),
      'help' => t('Display the count of flags for all timeslots linked to a pole.'),
      'id' => 'count_flags_by_pole',
    ],
  ];

  // Add Count Flags Limit by Pole field.
  $data['node_field_data']['count_flags_limit_by_pole'] = [
    'field' => [
      'title' => t('Count of flags limit by pole'),
      'help' => t('Display the count of flags limit for all timeslots linked to a pole.'),
      'id' => 'count_flags_limit_by_pole',
    ],
  ];

  // Add Calculate Volunteer Ratio field.
  $data['node_field_data']['calculate_volunteer_ratio'] = [
    'field' => [
      'title' => t('Calculate volunteer ratio'),
      'help' => t('Display the volunteer ratio for all timeslots linked to a pole.'),
      'id' => 'calculate_volunteer_ratio',
    ],
  ];

  // Add Calculate Timeslot Ratio field.
  $data['node_field_data']['calculate_timeslot_ratio'] = [
    'field' => [
      'title' => t('Calculate timeslot ratio'),
      'help' => t('Display the timeslot ratio for all timeslots.'),
      'id' => 'calculate_timeslot_ratio',
    ],
  ];

  $modal_operations_field = [
    'field' => [
      'title' => t('Modal Operations links'),
      'help' => t('Provides links to perform entity operations in Modal.'),
      'id' => 'mapam_volunteer_modal_entity_operations',
    ],
  ];
  $data['node_field_data']['mapam_volunteer_modal_entity_operations'] = $modal_operations_field;
  $data['search_api_datasource_programmation_entity_node']['mapam_volunteer_modal_entity_operations'] = $modal_operations_field;
  $data['search_api_datasource_timeslots_index_entity_node']['mapam_volunteer_modal_entity_operations'] = $modal_operations_field;
}

/**
 * Implements hook_flag_action_access().
 *
 * Only the referents of a pole register other users on its timeslots. The
 * registration rules (deadlines, limit, overlaps) are applied when flagging,
 * see \Drupal\mapam_volunteer\VolunteerFlagService.
 */
function mapam_volunteer_flag_action_access($action, FlagInterface $flag, AccountInterface $account, ?EntityInterface $flaggable = NULL) {
  if ($action !== 'flag_fse' || $flag->id() !== RegistrationValidator::FLAG_ID || !$flaggable instanceof NodeInterface) {
    return AccessResult::neutral();
  }
  $access = \Drupal::service('mapam_volunteer.pole_referents')->access($flaggable, $account);
  if ($access->isAllowed()) {
    return AccessResult::neutral()->inheritCacheability($access);
  }
  return AccessResult::forbidden('Only the referents of the pole register other users.')->inheritCacheability($access);
}

/**
 * Implements hook_node_access().
 *
 * Only the referents of a pole change the pole and its timeslots.
 */
function mapam_volunteer_node_access(NodeInterface $node, $operation, AccountInterface $account) {
  if (!in_array($operation, ['update', 'delete'], TRUE) || !in_array($node->bundle(), ['pole', 'timeslot', 'timeslot_recur'], TRUE)) {
    return AccessResult::neutral();
  }
  $access = \Drupal::service('mapam_volunteer.pole_referents')->access($node, $account);
  if ($access->isAllowed()) {
    return AccessResult::neutral()->inheritCacheability($access);
  }
  return AccessResult::forbidden('Only the referents of the pole change it.')->inheritCacheability($access);
}

/**
 * Implements hook_entity_field_access().
 *
 * Referents publish and unpublish their poles and timeslots.
 */
function mapam_volunteer_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL) {
  if ($operation !== 'edit' || $field_definition->getName() !== 'status' || !$items) {
    return AccessResult::neutral();
  }
  $node = $items->getEntity();
  if (!$node instanceof NodeInterface || !in_array($node->bundle(), ['pole', 'timeslot', 'timeslot_recur'], TRUE)) {
    return AccessResult::neutral();
  }
  return \Drupal::service('mapam_volunteer.pole_referents')->access($node, $account);
}

/**
 * Implements hook_entity_bundle_field_info_alter().
 */
function mapam_volunteer_entity_bundle_field_info_alter(&$fields, EntityTypeInterface $entity_type, $bundle) {
  // Referents only add timeslots to their own poles.
  if ($entity_type->id() === 'node' && in_array($bundle, ['timeslot', 'timeslot_recur'], TRUE) && isset($fields['field_pole'])) {
    $fields['field_pole']->addConstraint('MapamVolunteerManagedPole');
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for flag_fse_confirm_form.
 */
function mapam_volunteer_form_flag_fse_confirm_form_alter(array &$form, FormStateInterface $form_state) {
  $form['#validate'][] = 'mapam_volunteer_flag_fse_confirm_form_validate';
}

/**
 * Validates the registration of other users on a timeslot.
 */
function mapam_volunteer_flag_fse_confirm_form_validate(array &$form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  $flag = $form_object->getFlag();
  $timeslot = $form_object->getEntity();
  if ($form_state->hasAnyErrors() || $flag->id() !== RegistrationValidator::FLAG_ID) {
    return;
  }

  if ($form_state->getValue('user_type') === 'new') {
    $users = [$form_state->get('user')];
  }
  else {
    // Same as FlagFseConfirmForm::getSelectedUserIds(): checkboxes or an
    // autocomplete field.
    $uids = $form_state->getValue('uids');
    $uids = is_array($uids) ? array_values(array_filter($uids)) : array_column((array) $form_state->getValue('uid'), 'target_id');
    $users = User::loadMultiple($uids);
  }

  $errors = \Drupal::service('mapam_volunteer.registration_validator')->validateRegistration($timeslot, array_filter($users), \Drupal::currentUser());
  foreach ($errors as $error) {
    $form_state->setErrorByName('user', $error);
  }
}

