    'weight'      => 10,
    'visible'     => TRUE,
  ];

  $extra['node']['timeslot']['display']['volunteers_count'] = [
    'label'       => t('Volunteers Count'),
    'description' => t('Volunteers count field'),
    'weight'      => 10,
    'visible'     => TRUE,
  ];

  $extra['node']['timeslot']['display']['slots_occupancy'] = [
    'label'       => t('Slots Occupancy'),
    'description' => t('Slots occupancy field (calculated from flag count and flag limit)'),
    'weight'      => 10,
    'visible'     => TRUE,
  ];

  return $extra;
}

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function mapam_volunteer_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {

  if ($display->getComponent('volunteers_list')) {

    $flag = \Drupal::service('flag')->getFlagById('volunteer');

    $flaggings = \Drupal::entityTypeManager()
      ->getStorage('flagging')
      ->loadByProperties([
        'flag_id' => $flag->id(),
        'entity_type' => 'node',
        'entity_id' => $entity->id(),
      ]);

    $user_ids = array_map(fn($f) => $f->getOwnerId(), $flaggings);
    $users = User::loadMultiple($user_ids);

    $items = [];

    if (empty($users)) {
      $items[] = [
        '#markup' => t('No volunteers yet.'),
        '#attributes' => ['class' => ['list-group-item']],
      ];

      $build['volunteers_list'] = [
        '#theme' => 'container',
        '#attributes' => ['class' => ['volunteers-list', 'no-volunteers']],
        '#children' => [
          '#markup' => t('No volunteers yet.'),
        ],
      ];
    }
    else {
      foreach ($users as $user) {
        $items[] = [
          '#children' => $user->getDisplayName(),
          '#wrapper_attributes' => ['class' => ['list-group-item', 'p-1', 'm-0']],
        ];
      }

      $build['volunteers_list'] = [
        '#theme' => 'container',
        '#attributes' => ['class' => ['volunteers-list']],
        '#children' => [
          '#theme' => 'item_list',
          '#attributes' => ['class' => ['list-group', 'm-0']],
          '#items' => $items,
        ],
      ];
    }

  }

  // Get count of volunteer flaggings for this node.
  if ($display->getComponent('volunteers_count')) {
    $flag = Flag::load('volunteer');
    $flaggings = \Drupal::entityTypeManager()
      ->getStorage('flagging')
      ->loadByProperties([
        'flag_id' => $flag->id(),
        'entity_type' => 'node',
        'entity_id' => $entity->id(),
      ]);

    $build['volunteers_count'] = [
      '#markup' => '---' . count($flaggings),
    ];
  }

  // Calculate slots occupancy for this node in percentage.
  if ($display->getComponent('slots_occupancy')) {
    $flag = Flag::load('volunteer');
    $flaggings = \Drupal::entityTypeManager()
      ->getStorage('flagging')->loadByProperties([
        'flag_id' => $flag->id(),
        'entity_type' => 'node',
        'entity_id' => $entity->id(),
      ]);
    $count = count($flaggings);
    $capacity = $entity->hasField('field_flag_limit') ? $entity->get('field_flag_limit')->value : 0;

    $occupancy = $capacity > 0 ? round(($count / $capacity * 100), 0) : 0;
    // Ensure occupancy does not exceed 100%.
    $occupancy = min($occupancy, 100);
    if ($capacity > 0) {
      // Build a field with label and prgress bar.
      $build['#attached']['library'][] = 'mapam_volunteer/bootstrap_progress';
      $build['slots_occupancy'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['slots-occupancy']],
        'progress' => [
          '#type' => 'html_tag',
          '#tag' => 'div',
          '#attributes' => [
            'class' => ['progress'],
          ],
          'bar' => [
            '#type' => 'html_tag',
            '#tag' => 'div',
            '#attributes' => [
              'class' => ['progress-bar', 'bg-info', 'text-white'],
              'role' => 'progressbar',
              'style' => 'width: ' . $occupancy . '%;',
              'aria-valuenow' => $occupancy,
              'aria-valuemin' => 0,
              'aria-valuemax' => 100,
            ],
            '#value' => t('@occupancy% (@count/@capacity)', [
              '@occupancy' => $occupancy,
              '@count' => $count,
              '@capacity' => $capacity,
            ]),
          ],
        ],
      ];
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function mapam_volunteer_taxonomy_term_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  $name = $entity->getName();

  if ($display->getComponent('title_field')) {

    $build['title_field'] = [
      '#type'     => 'inline_template',
      '#template' => '<h3>{{ name }}</h3>',
      '#context'  => [
        'name' => $name,
      ],
    ];
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function mapam_volunteer_form_node_timeslot_recur_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  // Remove the default "Add another item" button.
  unset($form['field_smart_date_recur']['widget']['add_more']);

  // Add form elements for each allowed field.
  $form['common_fields'] = [
    '#title' => t('Common fields'),
    '#type' => 'fieldset',
    '#open' => TRUE,
    '#description' => t('These fields will be copied to all created timeslots.'),
    '#weight' => 10,
    '#group' => 'content',
  ];

  // Define allowed fields to move in the common fieldset.
  $allowed_fields = ['field_pole', 'field_flag_limit', 'field_event', 'og_audience'];
  foreach ($allowed_fields as $field_name) {
    if (!isset($form[$field_name])) {
      continue;
    }
    $form['common_fields'][$field_name] = $form[$field_name];
    $form['common_fields'][$field_name]['#group'] = 'common_fields';
    unset($form[$field_name]);
  }

  // Store allowed fields in form state.
  $form_state->set('allowed_fields', $allowed_fields);

  // Add a submit handler to process the common fields only for new entity.
  $form['actions']['submit']['#submit'][] = 'mapam_volunteer_bulk_timeslot_form_submit';

}

/**
 * Submit handler for the bulk timeslot form to process common fields.
 */
function mapam_volunteer_bulk_timeslot_form_submit($form, FormStateInterface $form_state) {
  $created_count = 0;

  $entity = $form_state->getFormObject()->getEntity();

  foreach ($entity->get('field_smart_date_recur') as $delta => $item) {
    $value = $item->getValue();

    $start = $value['value'];
    $end = $value['end_value'];

    $timeslot_data = [
      'type' => 'timeslot',
      'title' => $entity->label() . ' #' . ($delta + 1),
      'field_smart_date' => [
        'value' => $start,
        'end_value' => $end,
      ],
      'field_flag_limit' => $entity->get('field_flag_limit')->value,
    ];

    if ($entity->hasField('field_event') && !$entity->get('field_event')->isEmpty()) {
      $timeslot_data['field_event'] = $entity->get('field_event')->value;
    }
    if ($entity->hasField('field_pole') && !$entity->get('field_pole')->isEmpty()) {
      $timeslot_data['field_pole'] = $entity->get('field_pole')->value;
    }
    if ($entity->hasField('og_audience') && !$entity->get('og_audience')->isEmpty()) {
      $timeslot_data['og_audience'] = $entity->get('og_audience')->value;
    }

    $timeslot = Node::create($timeslot_data);
    $timeslot->save();

    $created_count++;
  }
  \Drupal::messenger()->addStatus(t('@count timeslots have been created.', ['@count' => $created_count]));
}

/**
 * Implements hook_views_pre_render().
 */
function mapam_volunteer_views_pre_render(ViewExecutable $view) {
  switch ($view->id()) {
    case 'pole_timeslots_index':
      $view->element['#attached']['library'][] = 'mapam_volunteer/bootstrap';
      break;

    case 'event_volunteers':
    case 'pole_volunteers':
      $view->element['#attached']['library'][] = 'mapam_volunteer/bootstrap_icons';
      break;

    case 'all_timeslots':
      // $view->element['#attached']['library'][] = 'mapam_volunteer/bootstrap';
      $view->element['#attached']['library'][] = 'mapam_volunteer/bootstrap_icons';
      $view->element['#attached']['library'][] = 'mapam_volunteer/sort_date_facet';
      break;

    case 'programmation_index':
      // $view->element['#attached']['library'][] = 'mapam_volunteer/bootstrap';
      $view->element['#attached']['library'][] = 'mapam_volunteer/bootstrap_icons';
      $view->element['#attached']['library'][] = 'mapam_volunteer/sort_date_facet';
      break;
  }
}

/**
 * Implements hook_entity_insert().
 */
function mapam_volunteer_entity_insert(EntityInterface $entity) {
  // AutoEntityLabel only supports content entities.
  if ($entity instanceof ContentEntityInterface) {
    if (!in_array($entity->bundle(), ['timeslot', 'session'])) {
      return;
    }
    // To support tokens that are only available after the entity has
    // been created (like id tokens) trigger a second save.
    // To do this without corrupting the entity run the
    // save operation at the end of the entity insert transaction.
    // To run code at the entity of the entity insert transaction
    // we need to register a transaction shutdown function.
    // Check the autolabel settings for the entity to see if we
    // need to register the shutdown function.
    $decorator = \Drupal::service('auto_entitylabel.entity_decorator');
    /** @var \Drupal\auto_entitylabel\AutoEntityLabelManager $decorated_entity */
    $decorated_entity = $decorator->decorate($entity);
    if ($decorated_entity->hasLabel()
      && $decorated_entity->getNewContentBehavior() === AutoEntityLabelManager::AFTER_SAVE
    ) {
      // Set entity label in memory so messages and such can use what will be
      // saved during shutdown.
      $decorator = \Drupal::service('auto_entitylabel.entity_decorator');
      /** @var \Drupal\auto_entitylabel\AutoEntityLabelManager $decorated_entity */
      $decorated_entity = $decorator->decorate($entity);
      if ($decorated_entity->hasLabel()) {
        $placeholder = strtr('%AutoEntityLabel: @entityId%', ['@entityId' => $entity->uuid()]);
        if ($entity->label() == $placeholder) {
          if ($decorated_entity->getNewContentBehavior() === AutoEntityLabelManager::AFTER_SAVE) {
            // Update entity's label in memory for anything running after us.
            $label = $decorated_entity->setLabel();
            $entity->setTitle($label);
            $entity->save();
            // Update messages that were using the placeholder label.
            $messenger = Drupal::messenger();
            $all_messages = $messenger->all();
            $messenger->deleteAll();
            foreach ($all_messages as $type => $messages) {
              foreach ($messages as $message) {
                if (strpos($message, $placeholder) >= 0) {
                  if ($message instanceof MarkupInterface) {
                    $message = Markup::create(str_replace($placeholder, $label, $message));
                  }
                  else {
                    $message = str_replace($placeholder, $label, $message);
                  }
                }
                $messenger->addMessage($message, $type);
              }
            }
          }
        }
      }
    }
  }
}

/**
 * Implements hook_entity_view_mode_alter().
 */
function mapam_volunteer_entity_view_mode_alter(&$view_mode, $entity, $context) {
  $current_user = \Drupal::currentUser();
  if ($view_mode == 'full' && $current_user && $entity->getEntityTypeId() === 'node' && $entity->bundle() === 'pole') {
    if ($current_user->isAnonymous()) {
      $view_mode = 'anonymous';
    }
    else {
      $view_mode = 'authenticated';
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for node.
 */
function mapam_volunteer_node_insert(NodeInterface $node) {
  mapam_volunteer_keep_one_current_event($node);
}

/**
 * Implements hook_ENTITY_TYPE_update() for node.
 */
function mapam_volunteer_node_update(NodeInterface $node) {
  mapam_volunteer_keep_one_current_event($node);
}

/**
 * Unchecks "current event" on the other events when an event is checked.
 */
function mapam_volunteer_keep_one_current_event(NodeInterface $node) {
  if ($node->bundle() === 'event' && $node->hasField(CurrentEvent::FIELD) && $node->get(CurrentEvent::FIELD)->value) {
    \Drupal::service('mapam_volunteer.current_event')->setCurrent($node);
  }
}

/**
 * Implements hook_theme_registry_alter().
 */
function mapam_volunteer_theme_registry_alter(&$theme_registry) {
  // Run after the preprocess of the themes: Gin removes the parents of nodes
  // from the breadcrumb.
  if (isset($theme_registry['breadcrumb'])) {
    $theme_registry['breadcrumb']['preprocess functions'][] = 'mapam_volunteer_restore_festival_breadcrumb';
  }
}

/**
 * Preprocess callback: restores "Event > Pole > Timeslot" after the theme.
 *
 * @see \Drupal\mapam_volunteer\MapamVolunteerBreadcrumbBuilder
 */
function mapam_volunteer_restore_festival_breadcrumb(array &$variables) {
  if (empty($variables['links']) || !\Drupal::service('mapam_volunteer.breadcrumb')->applies(\Drupal::routeMatch())) {
    return;
  }
  // Keep the first item of the theme, e.g. "Back to site" in Gin.
  $first = reset($variables['breadcrumb']);
  $variables['breadcrumb'] = [$first];
  foreach (array_slice($variables['links'], 1) as $link) {
    $url = $link->getUrl();
    $variables['breadcrumb'][] = [
      'text' => $link->getText(),
      'url' => $url->isRouted() && $url->getRouteName() === '<none>' ? '' : $url->toString(),
    ];
  }
}
