        'action' => 'flag',
        'view_mode' => NULL,
        'flag' => NULL,
        'flaggable' => NULL,
        'flag_deadline_passed' => FALSE,
        'unflagdeadline_passed' => FALSE,
        'flag_limit' => NULL,
        'flag_current' => NULL,
        'flag_remaining' => NULL,
        'flag_full' => NULL,
        'display_flag_link' => TRUE,
      ],
    ],
    'views_view_unformatted__who_flag_slot' => [
      'base hook' => 'views_view_unformatted',
    ],
    'views_view_field__pole_timeslots_index__flag_volunteer_limit_percentage' => [
      'base hook' => 'views_view_field',
    ],
    'views_view_field__pole_timeslots_index__flagging_users_volunteer_list' => [
      'base hook' => 'views_view_field',
    ],
    'views_view_field__who_flag_slot__name' => [
      'base hook' => 'views_view_field',
    ],
    'views_view_fields__who_flag_slot' => [
      'base hook' => 'views_view_fields',
    ],
    'entity_print__view__flagging_index' => [
      'template' => 'entity-print--view--flagging-index',
      'base hook' => 'entity_print',
      'variables' => [
        'view_title' => NULL,
      ],
    ],
    'entity_print__view__flagging_index_per_pole' => [
      'template' => 'entity-print--view--flagging-index',
      'base hook' => 'entity_print',
      'variables' => [
        'view_title' => NULL,
      ],
    ],
    'field__node__field_smart_date__timeslot' => [
      'base hook' => 'field',
    ],
    'field__node__field_primary_contacts__pole' => [
