<?php

/**
 * @file
 * Contains mapam_volunteer_og.module.
 */

use Drupal\node\Entity\Node;
use Drupal\Core\Form\FormStateInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme_registry_alter().
 *
 * This function prevents the Gin theme from processing breadcrumbs by removing
 * its preprocess callback from the theme registry. As a result, the theme will
 * no longer invoke gin_preprocess_breadcrumb().
 */
function mapam_volunteer_og_theme_registry_alter(&$theme_registry) {
  // Check if the 'breadcrumb' hook has any registered preprocess functions.
  if (isset($theme_registry['breadcrumb']['preprocess functions'])) {
    foreach ($theme_registry['breadcrumb']['preprocess functions'] as $key => $function) {
      // Identify the 'gin_preprocess_breadcrumb' function.
      if ($function === 'gin_preprocess_breadcrumb') {
        // Remove it so it won't be executed for breadcrumb rendering.
        unset($theme_registry['breadcrumb']['preprocess functions'][$key]);
      }
    }
  }
  $theme_registry['breadcrumb']['preprocess functions'][] = 'mapam_volunteer_og_custom_preprocess_breadcrumb';
}

/**
 * Implements fake hook_preprocess_breadcrumb().
 */
function mapam_volunteer_og_custom_preprocess_breadcrumb(&$variables) {
  // Get the route name of the current page.
  $route_name = \Drupal::routeMatch()->getRouteName();

  if ($route_name == 'mapam_volunteer.node.dashboard'
    || $route_name == 'entity.node.edit_form'
    || $route_name == 'entity.node.view') {

    $node_id = \Drupal::routeMatch()->getRawParameter('node');
    $node = \Drupal::entityTypeManager()->getStorage('node')->load($node_id);

    if ($node instanceof Node && in_array($node->bundle(), ['pole', 'timeslot'])) {
      $variables['breadcrumb'] = [$variables['breadcrumb'][0]];

      // Call a recursive function to get the tree of parent nodes of the current node.
      $volunteer_og_manager = \Drupal::service('mapam_volunteer_og.volunteer_og_manager');
      $parent_nodes = $volunteer_og_manager->getParentNodesTree($node);
      // Reverse the order of the parent nodes to have the top-level parent first.
      $parent_nodes = array_reverse($parent_nodes);

      // Add the parent nodes to the breadcrumb.
      foreach ($parent_nodes as $parent_node) {
        $variables['breadcrumb'][] = $parent_node;
      }

      // Finally, add the current node to the breadcrumb.
      $variables['breadcrumb'][] = [
        'text' => $node->label(),
        'url' => $node->toUrl(),
      ];
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function mapam_volunteer_og_form_alter(&$form, FormStateInterface $form_state, $form_id) {

  if ($form_id === 'ief_modal_simple_form') {

  }
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 */
function mapam_volunteer_og_inline_entity_form_entity_form_alter(array &$entity_form, FormStateInterface &$form_state) {
  // Get context from tempstore.
  $tempstore = \Drupal::service('tempstore.private')->get('vis_timeline');
  $context = $tempstore->get('context');

  if ($entity_form['#ief_id'] != 'ief_modal_node_timeslot' || !$context) {
    return;
  }

  $event = $context['event'];
  // Clone the pole field widget and use it as the OG audience widget.
  $event_widget = $entity_form['field_pole']['widget'][0];
  $event_widget['target_id']['#default_value'] = $event;

  $entity_form['og_audience']['widget'][0] = $event_widget;
  // Hide the OG audience field.
  $entity_form['og_audience']['#access'] = FALSE;
  // Hide the OG audience field.
  $entity_form['field_pole']['#access'] = FALSE;

}

/**
 * Implements hook_form_after_build().
 *
 * Runs the 'afterbuild' validation of a form with dependencies.
 * This function will run only once per form.
 */
function mapam_volunteer_og_form_after_build($form, &$form_state) {

}

/**
 * After build callback to hide OG audience field.
 */
function mapam_volunteer_og_hide_og_field(array $form, FormStateInterface $form_state) {
  $storage = $form_state->getStorage();
  $entity = $storage['entity'];
  $og_field = $this->findOgAudienceField($entity);

  if ($og_field && isset($form[$og_field])) {
    $form[$og_field]['#access'] = FALSE;
  }

  return $form;
}

/**
 * Implements hook_views_data_alter().
 */
function mapam_volunteer_og_views_data_alter(array &$data) {
  // Add Count Flags by Pole field.
  $data['node_field_data']['event_pole_title_link'] = [
    'field' => [
      'title' => t('Event Pole Title Link'),
      'help' => t('Display title of the pole with a link with current event.'),
      'id' => 'event_pole_title_link',
    ],
  ];
}

/**
 * Implements hook_views_pre_build().
 */
function mapam_volunteer_og_views_pre_build(ViewExecutable $view) {
  if ($view->id() == 'event_poles_admin') {

    $node = \Drupal::routeMatch()->getParameter('node');
    if (!$node instanceof Node || $node->bundle() !== 'event') {
      return;
    }

    /** @var \Drupal\mapam_volunteer_og\VolunteerOgManagerInterface $volunteer_og_manager */
    $volunteer_og_manager = \Drupal::service('mapam_volunteer_og.volunteer_og_manager');
    $organization = $volunteer_og_manager->getParentGroup($node);
    if ($organization) {

      $view->setArguments([$organization->id()]);
    }
  }

}

